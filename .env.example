# Historical configuration reference. Use only your own disposable resources.
# The application remains closed to sign-ups and purchases.
# Never commit real credentials; keep local values in ignored .env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
APP_SECRET=replace-with-your-own-random-secret

# Google OAuth, Vertex AI, and Google Cloud Storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# PEM key with literal \n separators; do not paste a real key into this file.
GCP_PRIVATE_KEY=
GCS_BUCKET_NAME=
OPENAI_API_KEY=

# Optional Cloudflare AI gateway
CLOUDFLARE_GATEWAY=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=

# Mailgun constructs its client at import time and needs a nonempty key to build.
# This placeholder cannot authenticate; use a separate test account for email work.
MAILGUN_API_KEY=local-placeholder-not-a-real-key
MAILGUN_DOMAIN=example.com
MAILGUN_EMAIL=assistant@example.com
MAILGUN_WEBHOOK_SIGNING_KEY=

# Redis / Upstash; REDIS_URL and KV_URL are legacy URL fallbacks.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contact form and analytics
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=local-placeholder-not-a-real-key
NEXT_PUBLIC_POSTHOG_HOST=http://127.0.0.1:9

# Historical billing only; purchase routes remain closed.
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_PRODUCT_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_API_KEY=
NEXT_PUBLIC_LS_PLUS_BUY_LINK=
NEXT_PUBLIC_LS_CUSTOMER_PORTAL_LINK=
